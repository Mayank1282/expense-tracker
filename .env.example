APP_NAME=Ledger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MongoDB
# ---------------------------------------------------------------------------
# One URI serves local development and production. MongoDB Atlas gives you an
# `mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority`
# string that drops straight in here with no other change.
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ledger
MONGODB_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Session / cache / queue
# ---------------------------------------------------------------------------
# File-backed on purpose. This is a single-instance monolith, so there is no
# second container to share state with, and it keeps the app free of any SQL
# dependency — the whole point of the MongoDB choice here.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Mail — required for password reset
# ---------------------------------------------------------------------------
# Brevo's SMTP relay, shared with Projects 1 and 3. It is plain SMTP, so no
# extra package is needed — `smtp` is the built-in transport. Set MAIL_MAILER=log
# to write reset emails into storage/logs instead of sending them.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="ledger@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
